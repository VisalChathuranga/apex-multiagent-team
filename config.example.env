# Copy to .env or export these before registering / running.
# Shared world (ALL agents must use the same file):
TEAM_STATE_FILE=./shared_state.json
BRAIN_DIR=./second_brain

# Token-saving tuning:
MAX_AGENTS=4
MSG_ROTATE_LIMIT=800
APEX_CACHE_TTL=3600
APEX_PROMPT_ENGINEER=1

# Skill libraries (optional — fallback keyword map used if absent):
APEX_ANTIGRAVITY_DIR=~/.gemini/antigravity/skills
APEX_CYBERSEC_DIR=~/.gemini/cybersecurity-skills/skills

# CLI launch overrides (optional). {seed} is the bootstrap prompt.
# Remove --dangerously-skip-permissions to require approvals.
# APEX_CLI_CLAUDE=claude --dangerously-skip-permissions {seed}
# APEX_CLI_CODEX=codex {seed}
# APEX_CLI_GEMINI=gemini {seed}
# APEX_CLI_CURSOR=cursor-agent {seed}

# Test without opening real terminals:
# APEX_SPAWN_DRYRUN=1

# ---- Base server env (from FEATURES_GUIDE.md) — all optional ----
TEAM_BACKUP_DIR=./team_backups   # where auto-backups go
BACKUP_KEEP=10                   # how many backups to keep
BACKUP_EVERY=15                  # auto-backup every N writes
HEARTBEAT_STALE=120              # seconds before an agent is "stale" (ping)
DASHBOARD_PORT=8765              # live dashboard port
DASHBOARD_HOST=127.0.0.1         # set 0.0.0.0 for LAN access
OBSIDIAN_VAULT=                  # path to sync notes/brain into Obsidian
WEBHOOK_URL=                     # Slack/Discord/Teams webhook for notifications
